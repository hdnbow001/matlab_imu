function updateDebugDisplay(debugHandles, currentIndex, debugData, displacementX, displacementY, displacementZ, ...
                           continuous_displacementX, continuous_displacementY, continuous_displacementZ, ...
                           continuous_linAccelX, continuous_linAccelY, continuous_linAccelZ, ...
                           continuous_velX, continuous_velY, continuous_velZ)
    % 更新调试显示 - 2行3列布局
    % 第一行：窗口模式数据（5秒窗口）
    % 第二行：连续模式数据（从开始累计）
    
    % 确保有足够的数据点
    if currentIndex < 2
        return;
    end
    
    % 创建时间轴
    time_axis = 1:currentIndex;
    
    % 计算5秒窗口的起始索引
    window_size = 50; % 5秒 * 10Hz = 50个采样点
    window_start = max(1, currentIndex - window_size + 1);
    window_indices = window_start:currentIndex;
    
    % === 第一行：窗口模式数据 ===
    
    % 窗口模式线性加速度
    if currentIndex <= length(debugData.linAccelX)
        set(debugHandles.window_accel_x, 'XData', window_indices, 'YData', debugData.linAccelX(window_indices));
        set(debugHandles.window_accel_y, 'XData', window_indices, 'YData', debugData.linAccelY(window_indices));
        set(debugHandles.window_accel_z, 'XData', window_indices, 'YData', debugData.linAccelZ(window_indices));
    end
    
    % 窗口模式速度
    if currentIndex <= length(debugData.velX)
        set(debugHandles.window_velocity_x, 'XData', window_indices, 'YData', debugData.velX(window_indices));
        set(debugHandles.window_velocity_y, 'XData', window_indices, 'YData', debugData.velY(window_indices));
        set(debugHandles.window_velocity_z, 'XData', window_indices, 'YData', debugData.velZ(window_indices));
    end
    
    % 窗口模式位移
    if currentIndex <= length(displacementX)
        set(debugHandles.window_displacement_x, 'XData', window_indices, 'YData', displacementX(window_indices));
        set(debugHandles.window_displacement_y, 'XData', window_indices, 'YData', displacementY(window_indices));
        set(debugHandles.window_displacement_z, 'XData', window_indices, 'YData', displacementZ(window_indices));
    end
    
    % === 第二行：连续模式数据 ===
    
    % 连续模式线性加速度
    if currentIndex <= length(continuous_linAccelX)
        set(debugHandles.continuous_accel_x, 'XData', time_axis, 'YData', continuous_linAccelX(1:currentIndex));
        set(debugHandles.continuous_accel_y, 'XData', time_axis, 'YData', continuous_linAccelY(1:currentIndex));
        set(debugHandles.continuous_accel_z, 'XData', time_axis, 'YData', continuous_linAccelZ(1:currentIndex));
    end
    
    % 连续模式速度
    if currentIndex <= length(continuous_velX)
        set(debugHandles.continuous_velocity_x, 'XData', time_axis, 'YData', continuous_velX(1:currentIndex));
        set(debugHandles.continuous_velocity_y, 'XData', time_axis, 'YData', continuous_velY(1:currentIndex));
        set(debugHandles.continuous_velocity_z, 'XData', time_axis, 'YData', continuous_velZ(1:currentIndex));
    end
    
    % 连续模式位移
    if currentIndex <= length(continuous_displacementX)
        set(debugHandles.continuous_displacement_x, 'XData', time_axis, 'YData', continuous_displacementX(1:currentIndex));
        set(debugHandles.continuous_displacement_y, 'XData', time_axis, 'YData', continuous_displacementY(1:currentIndex));
        set(debugHandles.continuous_displacement_z, 'XData', time_axis, 'YData', continuous_displacementZ(1:currentIndex));
    end
    
    % === 更新标题和标签 ===
    
    % 窗口模式标题
    title(debugHandles.window_accel_axes, sprintf('窗口加速度 - 点 %d', currentIndex));
    title(debugHandles.window_velocity_axes, sprintf('窗口速度 - 点 %d', currentIndex));
    title(debugHandles.window_displacement_axes, sprintf('窗口位移 - 点 %d', currentIndex));
    
    % 连续模式标题
    title(debugHandles.continuous_accel_axes, sprintf('连续加速度 - 点 %d', currentIndex));
    title(debugHandles.continuous_velocity_axes, sprintf('连续速度 - 点 %d', currentIndex));
    title(debugHandles.continuous_displacement_axes, sprintf('连续位移 - 点 %d', currentIndex));
    
    % === 自动调整坐标轴范围 ===
    
    % 窗口模式坐标轴调整
    if ~isempty(window_indices)
        % adjustAxisLimits(debugHandles.window_accel_axes, window_time, ...
        %                 debugData.linAccelX(window_indices), ...
        %                 debugData.linAccelY(window_indices), ...
        %                 debugData.linAccelZ(window_indices));
        % 
        % adjustAxisLimits(debugHandles.window_velocity_axes, window_time, ...
        %                 debugData.velX(window_indices), ...
        %                 debugData.velY(window_indices), ...
        %                 debugData.velZ(window_indices));
        % 
        % adjustAxisLimits(debugHandles.window_displacement_axes, window_time, ...
        %                 displacementX(window_indices), ...
        %                 displacementY(window_indices), ...
        %                 displacementZ(window_indices));
        adjustAxisLimits(debugHandles.window_accel_axes, window_time, ...
                        debugData.linAccelX(window_indices), ...
                        debugData.linAccelY(window_indices), ...
                        debugData.linAccelZ(window_indices));
        
        adjustAxisLimits(debugHandles.window_velocity_axes, window_time, ...
                        debugData.velX(window_indices), ...
                        debugData.velY(window_indices), ...
                        debugData.velZ(window_indices));
        
        adjustAxisLimits(debugHandles.window_displacement_axes, window_time, ...
                        displacementX(window_indices), ...
                        displacementY(window_indices), ...
                        displacementZ(window_indices));
    end
    
    % 连续模式坐标轴调整
    if currentIndex >= 1
        adjustAxisLimits(debugHandles.continuous_accel_axes, time_axis, ...
                        continuous_linAccelX(1:currentIndex), ...
                        continuous_linAccelY(1:currentIndex), ...
                        continuous_linAccelZ(1:currentIndex));
        
        adjustAxisLimits(debugHandles.continuous_velocity_axes, time_axis, ...
                        continuous_velX(1:currentIndex), ...
                        continuous_velY(1:currentIndex), ...
                        continuous_velZ(1:currentIndex));
        
        adjustAxisLimits(debugHandles.continuous_displacement_axes, time_axis, ...
                        continuous_displacementX(1:currentIndex), ...
                        continuous_displacementY(1:currentIndex), ...
                        continuous_displacementZ(1:currentIndex));
    end
    
    % 刷新图形显示
    drawnow limitrate;
end